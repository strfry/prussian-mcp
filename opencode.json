{
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    "prussian-mcp": {
      "type": "local",
      "command": ["uv", "run", "mcp_server.py"],
      "enabled": true,
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": ["docker", "run",
        "--network", "host",
        "--rm", "--init", "-i", 
        "mcr.microsoft.com/playwright/mcp"
      ],
      "environment": {
      },
      "enabled": true,
      "timeout": 5000
    }
  }
}

