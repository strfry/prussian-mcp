{
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    "prussian-mcp": {
      "type": "local",
      "command": ["uv", "run", "prussian-mcp"],
      "enabled": true,
      "timeout": 30000
    },
    "codemap": {
      "type": "local",
      "enabled": true,
      "command": ["codemap", "mcp"]
    },
    "playwright": {
      "type": "local",
      "command": ["docker", "run",
        "--network", "host",
        "--rm", "--init", "-i", 
        "mcr.microsoft.com/playwright/mcp"
      ],
      "environment": {
      },
      "enabled": true,
      "timeout": 5000
    }
  }
}

